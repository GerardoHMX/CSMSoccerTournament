---
import { Image } from 'astro:assets';
import { imagen } from '../lib/imagenes';
import { t } from '../lib/i18n';

interface Props { sitio: Record<string, any>; secciones: { id: string; nombre: string; en_menu: boolean }[] }
const { sitio, secciones } = Astro.props;
const logo = imagen(sitio.colegio_logo);
const enMenu = secciones.filter((s) => s.en_menu && s.nombre && s.nombre !== '-');
// El menú de escritorio solo conoce estas secciones (igual que el sitio original); el móvil muestra todas.
const escritorio = new Set(['inicio', 'equipos', 'jornadas', 'clasificacionGrupal', 'bracket', 'goleadoresSection', 'sancionadosSection', 'resultadosSection', 'noticiasSection']);
---
<header class="w-full bg-white border-b border-gray-100 sticky top-0 z-50 shadow-sm">
  <div class="mx-auto px-2 sm:px-4 lg:px-6">
    <div class="flex items-center justify-between h-16 md:h-20 gap-2">
      <div class="flex items-center min-w-[4rem] min-h-[2.5rem] md:min-w-16 md:min-h-16">
        <a href={sitio.colegio_url} target="_blank" rel="noopener noreferrer" class="block">
          {logo && <Image src={logo} alt="Logo" width={128} class="h-full w-auto md:w-16 md:h-16 object-contain" loading="eager" />}
        </a>
      </div>
      <nav id="desktopNav" class="hidden desktopNav:flex items-center justify-center gap-4">
        {enMenu.filter((s) => escritorio.has(s.id)).map((s) => (
          <a href={`#${s.id}`} class="text-sm lg:text-md font-medium text-brand-text-dark hover:text-brand-red transition-colors uppercase no-underline" data-translate={s.id}>{t(s.id)}</a>
        ))}
      </nav>
      <div class="flex items-center justify-center gap-2">
        <div id="language-selector" class="flex items-center gap-1">
          <button data-lang="es" class="lang-btn px-1 py-1 rounded text-sm font-medium hover:text-brand-blue transition-colors active bg-brand-blue text-white" aria-label="Español">ES</button>
          <button data-lang="en" class="lang-btn px-1 py-1 rounded text-sm font-medium text-gray-600 hover:text-brand-blue transition-colors" aria-label="English">EN</button>
        </div>
        <a href={sitio.instagram_url} target="_blank" rel="noopener noreferrer" class="text-brand-text-dark hover:text-brand-red transition-colors px-1" aria-label="Instagram">
          <svg class="w-5 h-5 lg:w-6 lg:h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>
        <button id="mobileMenuButton" class="desktopNav:hidden text-brand-text-dark hover:text-brand-red transition-colors" aria-label="Menú">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
    <div id="mobileMenu" class="hidden desktopNav:hidden pb-4 border-t border-gray-100 mt-2">
      <nav id="mobileNav" class="flex flex-col space-y-1 pt-4 px-4">
        {enMenu.map((s) => (
          <a href={`#${s.id}`} class="text-base font-medium text-brand-text-dark hover:text-brand-red transition-colors uppercase no-underline hover:bg-brand-gold px-2 py-1 rounded-md" data-translate={s.id}>{t(s.id)}</a>
        ))}
      </nav>
    </div>
  </div>
</header>
