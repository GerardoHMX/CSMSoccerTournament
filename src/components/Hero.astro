---
import { t } from '../lib/i18n';
const { sitio } = Astro.props;
---
<section id="inicio" class="w-full h-full flex items-center overflow-hidden hero-section lg:bg-fill md:bg-cover px-6 py-6">
  <div class="w-full flex items-center">
    <div class="w-full flex flex-col items-center gap-1 justify-center">
      <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold text-brand-gold mb-3" data-translate="hero_title">{t('hero_title')}</h3>
      <div class="flex flex-col gap-0">
        <h1 class="text-6xl sm:text-7xl lg:text-8xl font-bold text-brand-white">{sitio.torneo_nombre}</h1>
        <span class="text-2xl font-bold text-brand-white text-right">{sitio.torneo_anio}</span>
      </div>
    </div>
  </div>
</section>
