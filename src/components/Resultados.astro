---
// "Resultados": tabla general por ciclo (todos los grupos juntos)
import Tabs from './Tabs.astro';
import Logo from './Logo.astro';
import TablaLeyenda from './TablaLeyenda.astro';
import { t } from '../lib/i18n';
const { clasificacion, ciclos } = Astro.props;
const th = 'font-bold uppercase py-2 px-2 md:py-4 md:px-4 text-xs sm:text-md md:text-lg lg:text-lg';
const td = 'py-2 px-2 md:py-4 md:px-4 text-center font-medium text-xs sm:text-md md:text-lg lg:text-lg';
const dg = (n: number) => (n >= 0 ? `+${n}` : `${n}`);
---
<section id="resultadosSection" class="w-full h-full flex flex-col overflow-hidden lg:bg-fill md:bg-cover px-6 bg-brand-bg-light" data-filtro="ciclo">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-8">
    <h3 class="text-3xl md:text-4xl text-center text-brand-blue font-bold uppercase" data-translate="section_results_title">{t('section_results_title')}</h3>
    <Tabs id="selector-resultados" />
  </div>
  {ciclos.map((ciclo) => (
    <div id={`resultados${ciclo}`} class="overflow-x-auto mb-6 mt-6" data-ciclo={ciclo}>
      {clasificacion[ciclo].length === 0
        ? <p class="text-gray-500 text-center" data-translate="msg_no_data">{t('msg_no_data')}</p>
        : (
        <div class="rounded-brand overflow-hidden shadow-lg">
          <div class="overflow-x-auto">
            <div class="flex items-center justify-between gap-2">
              <h4 class="text-3xl font-bold text-brand-gold mb-2 flex items-center gap-2">{ciclo}</h4>
            </div>
            <table class="w-full min-w-full" style="border-collapse: collapse;">
              <thead class="sticky top-0">
                <tr style="background-color: #B30000; color: white;">
                  <th class={th} style="text-align: left; padding-left: 1rem;" data-translate="table_position">POS</th>
                  <th class={th} style="text-align: left; padding-left: 1rem;" data-translate="table_team">Equipo</th>
                  <th class={th} style="text-align: center;" data-translate="table_played">PJ</th>
                  <th class={th} style="text-align: center;" data-translate="table_won">PG</th>
                  <th class={th} style="text-align: center;" data-translate="table_drawn">PE</th>
                  <th class={th} style="text-align: center;" data-translate="table_lost">PP</th>
                  <th class={th} style="text-align: center;" data-translate="table_goals_for">GF</th>
                  <th class={th} style="text-align: center;" data-translate="table_goals_against">GC</th>
                  <th class={th} style="text-align: center;" data-translate="table_goals_diff">DG</th>
                  <th class={th} style="text-align: center; padding-right: 1rem;" data-translate="table_points">PTS</th>
                </tr>
              </thead>
              <tbody class="h-96 overflow-y-auto">
                {clasificacion[ciclo].map((f, i) => (
                  <tr class="bg-white border-gray-100 border border-b">
                    <td class="py-2 px-2 md:py-4 md:px-4 font-medium" style="text-align: left; padding-left: 1rem; color: #333333;">{f.PJ > 0 ? String(i + 1).padStart(2, '0') : ''}</td>
                    <td class="py-2 px-2 md:py-4 md:px-4" style="text-align: left; padding-left: 1rem;">
                      <div class="flex items-center gap-3">
                        {f.equipo.logo && <Logo ruta={f.equipo.logo} alt={f.equipo.nombre} ancho={64} class="w-8 h-8 object-contain transition-transform duration-300 hover:scale-150" />}
                        <span class="font-medium uppercase text-xs sm:text-md md:text-lg lg:text-lg">{f.equipo.nombre}</span>
                      </div>
                    </td>
                    <td class={td}>{f.PJ}</td><td class={td}>{f.PG}</td><td class={td}>{f.PE}</td><td class={td}>{f.PP}</td>
                    <td class={td}>{f.GF}</td><td class={td}>{f.GC}</td><td class={td}>{dg(f.DG)}</td>
                    <td class={td} style="color: #333333; padding-right: 1rem;">{f.Pts}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <TablaLeyenda ptsAlFinal />
        </div>
      )}
    </div>
  ))}
</section>
