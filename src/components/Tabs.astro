---
// Pestañas TODOS / ESO / BCH (estilo Bootstrap "nav-tabs"). El filtrado lo hace src/scripts/filtros.ts
import { t } from '../lib/i18n';
const { id, ancho = 'w-80' } = Astro.props;
---
<ul class={`nav nav-tabs ${ancho}`} id={id} role="tablist">
  <li class="nav-item" role="presentation"><button class="nav-link text-xs sm:text-md md:text-lg active" data-ciclo="TODOS" type="button" data-translate="filter_all">{t('filter_all')}</button></li>
  <li class="nav-item" role="presentation"><button class="nav-link text-xs sm:text-md md:text-lg" data-ciclo="ESO" type="button">ESO</button></li>
  <li class="nav-item" role="presentation"><button class="nav-link text-xs sm:text-md md:text-lg" data-ciclo="BCH" type="button">BCH</button></li>
</ul>
